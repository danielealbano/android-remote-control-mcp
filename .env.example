# Environment variables for integration tests
# Copy this file to .env and fill in the values:
#   cp .env.example .env
#
# The .env file is gitignored and will not be committed.

# Needed to run the ngrok integration test (NgrokTunnelIntegrationTest); leave empty to skip it.
# Get your authtoken from https://dashboard.ngrok.com/get-started/your-authtoken
NGROK_AUTHTOKEN=

# Optional: absolute dir containing model_int8.onnx + tokenizer.json for the gated
# Privacy Mode real-model test (OrtPiiModelRunnerRealModelTest). Leave empty to skip.
PRIVACY_MODEL_DIR=
